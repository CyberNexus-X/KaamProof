# KaamProof — copy to .env.local. Never commit real keys.
# Supabase (required beyond demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# AI provider (optional; without it the deterministic MockAdapter is used)
AI_PROVIDER=mock
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# Demo mode: "true" uses the seeded in-memory store (no Supabase/AI keys needed)
DEMO_MODE=true
